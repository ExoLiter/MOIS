MongoDB
<- concept_nosql_database;
=> nrel_main_idtf:
    [MongoDB]
    (*
        <- lang_ru;;
    *);
-> rrel_consistency_model:
    eventual_consistency;
-> rrel_data_model:
    document_data_model;
-> rrel_query_language:
    mongo_query_language;
-> rrel_use_case:
    content_management_use_case;
    analytics_dashboard_use_case;
-> rrel_license:
    SSPL_license;;

