MongoDB
<- concept_nosql_database;
=> nrel_main_idtf:
    [MongoDB]
    (*
        <- lang_ru;;
    *);
-> rrel_data_model:
    document_model;
-> rrel_query_language:
    MongoQL;
-> rrel_developer:
    MongoDB_Inc;
-> rrel_consistency_model:
    eventual_consistency;
-> rrel_use_case:
    content_management;
    session_storage;
=> nrel_license_type:
    SSPL_license;;

