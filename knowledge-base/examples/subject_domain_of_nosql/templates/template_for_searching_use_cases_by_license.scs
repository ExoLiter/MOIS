@search_use_cases_by_license_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._license <-_ concept_license_type);;
            nrel_license_type _-> (.._database _=> .._license);;
            @output_param1 = (.._database <-_ concept_nosql_database);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *);
    rrel_next_template: {
        rrel_init_template: {
            rrel_template: [*
                @input_param1 = (.._database <-_ concept_nosql_database);;
                rrel_use_case _-> (.._database _-> .._use_case);;
                @output_param1 = (.._use_case <-_ concept_use_case);;
            *];
            rrel_template_input_params: {
                @input_param1
            };
            rrel_template_output_params: {
                @output_param1
            }
        } (* <- nrel_search_set_template;; *)
    } (* <- nrel_fixed_search_strategy_template;; *)
};; 

@search_use_cases_by_license_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска сценариев использования по лицензии NoSQL СУБД]
    (*
        <- lang_ru;;
    *);;
