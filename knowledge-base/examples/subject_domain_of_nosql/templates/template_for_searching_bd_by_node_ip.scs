@search_bd_by_node_ip_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._ip <-_ concept_ip);;
            nrel_ip _-> (.._node _=> .._ip);;
            @output_param1 = (.._node <-_ concept_node);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *);
    rrel_next_template: {
        rrel_init_template: {
            rrel_template: [*
                @input_param1 = (.._node <-_ concept_node);;
                nrel_database _-> (.._node _=> .._db);;
                @output_param1 = (.._db <-_ concept_database);;
            *];
            rrel_template_input_params: {
                @input_param1
            };
            rrel_template_output_params: {
                @output_param1
            }
        } (* <- nrel_search_set_template;; *)
    } (* <- nrel_fixed_search_strategy_template;; *)
};;

@search_bd_by_node_ip_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска баз данных по айпи сервера]
    (*
        <- lang_ru;;
    *);;
