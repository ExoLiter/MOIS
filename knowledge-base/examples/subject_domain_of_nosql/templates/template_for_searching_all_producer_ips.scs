@search_all_producer_ips_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._message_queue <-_ concept_message_queue);;
            rrel_producer _-> (.._message_queue _-> .._server);;
            @output_param1 = (.._server <-_ concept_node);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *);
    rrel_next_template: {
        rrel_init_template: {
            rrel_template: [*
                @input_param1 = (.._server <-_ concept_node);;
                nrel_ip _-> (.._server _=> .._ip);;
            *];
            rrel_template_input_params: {
                @input_param1
            }
        } (* <- nrel_search_set_template;; *)
    } (* <- nrel_fixed_search_strategy_template;; *)
};;

@search_all_producer_ips_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска айпи продюсеров в очереди сообщений]
    (*
        <- lang_ru;;
    *);;
