@search_databases_by_use_case_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._use_case <-_ concept_use_case);;
            rrel_use_case _-> (.._database _-> .._use_case);;
            @output_param1 = (.._database <-_ concept_nosql_database);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_template;; *)
} (* <- nrel_fixed_search_strategy_template;; *);;

@search_databases_by_use_case_template
<- nrel_fixed_search_strategy_template;
