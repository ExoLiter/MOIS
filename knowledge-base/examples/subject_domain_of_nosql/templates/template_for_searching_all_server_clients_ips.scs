@search_all_clients_ips_by_server_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._server <-_ concept_server);;
            rrel_client _-> (.._client <-_ .._server);;
            @output_param1 = (.._client <-_ concept_node);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *);
    rrel_next_template: {
        rrel_init_template: {
            rrel_template: [*
                @input_param1 = (.._client <-_ concept_node);;
                nrel_ip _-> (.._client _=> .._ip);;
                @output_param1 = (.._ip <-_ concept_ip);;
            *];
            rrel_template_input_params: {
                @input_param1
            };
            rrel_template_output_params: {
                @output_param1
            }
        } (* <- nrel_search_set_template;; *)
    } (* <- nrel_fixed_search_strategy_template;; *)
};;

@search_all_clients_ips_by_server_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска айпи клиентов сервера]
    (*
        <- lang_ru;;
    *);;
