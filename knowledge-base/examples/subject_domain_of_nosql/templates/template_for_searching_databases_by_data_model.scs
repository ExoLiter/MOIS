@search_databases_by_data_model_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._data_model <-_ concept_data_model);;
            rrel_data_model _-> (.._database _-> .._data_model);;
            @output_param1 = (.._database <-_ concept_nosql_database);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_template;; *)
} (* <- nrel_fixed_search_strategy_template;; *);;

@search_databases_by_data_model_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
