@search_databases_by_developer_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._developer <-_ concept_company);;
            rrel_developer _-> (.._database _-> .._developer);;
            @output_param1 = (.._database <-_ concept_nosql_database);;
        *];
        rrel_template_input_params: {
            @input_param1
        };
        rrel_template_output_params: {
            @output_param1
        }
    } (* <- nrel_search_set_template;; *)
};; 

@search_databases_by_developer_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска NoSQL СУБД по разработчику]
    (*
        <- lang_ru;;
    *);;
