ui_menu_for_searching_consumers_databases_in_message_queue
<- ui_user_command_class_atom;
<- ui_user_command_class_view_kb;
=> nrel_main_idtf:
	[Найти базы данных по серверам-консьюмерам очереди сообщений]
	(*
		<- lang_ru;;
	*);
	[Search databases of consumers in message queue]
	(*
		<- lang_en;;
	*);
=> ui_nrel_command_template:
	[*
		action_search_consumers_databases_in_message_queue _-> .._action
		(*
			_-> rrel_1:: ui_arg_1;;
		*);;
		.._action <-_ action;;
	*];
=> ui_nrel_command_lang_template:
	[Найти базы данных очереди сообщений $ui_arg_1]
	(*
		<- lang_ru;;
	*);
	[Search databases of message queue $ui_arg_1]
	(*
		<- lang_en;;
	*);;
